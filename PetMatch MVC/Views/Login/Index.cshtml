@{ Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Entrar - PetMatch</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/global.css">
    <style>
        .pagina-form { 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            padding: 24px; 
            }
        .card-form { 
            background: #fff; 
            padding: 40px; 
            border-radius: 28px; 
            width: 100%; 
            max-width: 420px; 
            box-shadow: 0 18px 40px rgba(16,36,66,0.12); 
            }
        .card-form h2 { 
            color: var(--azul-marinho-escuro); 
            font-weight: 800; 
            margin-bottom: 8px; 
            }
        .card-form p { 
            color: var(--texto-cinza); 
            font-size: 0.88rem; 
            margin-bottom: 24px; 
            }
        .campo { 
            margin-bottom: 16px; 
            }
        .campo label { 
            display: block; 
            font-size: 0.85rem; 
            font-weight: 600; 
            margin-bottom: 6px; 
            }
        .campo input { 
            width: 100%; 
            padding: 12px 16px; 
            border: 1px solid #cbd5e1; 
            border-radius: 14px; 
            font-size: 0.9rem; 
            }
        .erro-msg { 
            background: #fee2e2; 
            color: #b91c1c; 
            padding: 10px 14px; 
            border-radius: 12px; 
            font-size: 0.85rem; 
            margin-bottom: 16px; 
            }
        .btn-submit { 
            width: 100%; 
            padding: 13px; 
            border: none; 
            border-radius: 25px; 
            background: var(--laranja-primario); 
            color: #fff; font-weight: 600; 
            font-size: 0.95rem; 
            cursor: pointer; 
            margin-top: 8px; 
            }
        .btn-submit:hover { 
            background: var(--laranja-hover); 
            }
        .link-rodape-form { 
            text-align: center; 
            margin-top: 20px; 
            font-size: 0.85rem; 
            }
        .link-rodape-form a { 
            color: var(--azul-primario); 
            font-weight: 600; 
            text-decoration: none; 
            }
    </style>
</head>
<body>
    <div class="pagina-form">
        <div class="card-form">
            <h2>Bem-vindo de volta 💛</h2>
            <p>Entre na sua conta para anunciar ou adotar um pet.</p>

            @if (ViewBag.Erro != null)
            {
                <div class="erro-msg">@ViewBag.Erro</div>
            }

            <form method="post" action="/Login/Login">
                <div class="campo">
                    <label>E-mail</label>
                    <input type="email" name="email" required placeholder="seu@email.com">
                </div>
                <div class="campo">
                    <label>Senha</label>
                    <input type="password" name="senha" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn-submit">Entrar</button>
            </form>

            <div class="link-rodape-form">
                Não tem conta? <a href="/Login/Cadastrar">Cadastre-se</a><br><br>
                <a href="/">← Voltar para o início</a>
            </div>
        </div>
    </div>
</body>
</html>